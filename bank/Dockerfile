FROM eclipse-temurin:21-jdk AS build
WORKDIR /app

COPY . .
RUN ./mvnw clean package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar

ARG NTTDATA_BANK_DB_URL
ARG NTTDATA_BANK_DB_USERNAME
ARG NTTDATA_BANK_DB_PASSWORD

ENV NTTDATA_BANK_DB_URL=$NTTDATA_BANK_DB_URL
ENV NTTDATA_BANK_DB_USERNAME=$NTTDATA_BANK_DB_USERNAME
ENV NTTDATA_BANK_DB_PASSWORD=$NTTDATA_BANK_DB_PASSWORD

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]